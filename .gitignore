# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
dev.db
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# fyers token
fyers_token.txt

# build artifacts — never commit these
deploy_bundle.tar.gz
deploy_bundle.zip
next-build.tar.gz
next-build.zip
dotnext.tar.gz
standalone.tar.gz
prisma.tar.gz
*.tar.gz
*.zip

# generated remote deploy script (scratch, never commit)
remote_deploy.sh

# local untracked configs / scripts
*.local.env
*.local.sh

# temporary debug / scratch files
*.sql
!prisma/migrations/**/*.sql
*.txt
ssh_history.jsonl
history.txt
history_commands.txt
raw*.txt
clean_ssh_history.txt
migration_diff.sql
scratch/
prisma/*.old.prisma

# one-off local mutation / probe scripts (never ship)
/check-*.js
/count-db.js
/dry-run.ts
/fix-pnlpct.js
/run-populator.ts
/test-nse.js
/test-yf.js
/test-yf.mjs
/test-yf-inst.mjs
/update-cron.js
/update-trades.js
/ops/trigger.ts
/scripts/read-db.ts
/scripts/read-scanner.mjs
/scripts/update-db.mjs
/scripts/update-db.ts

# secrets
server.env
scratch/*.env*
scratch/*token*
