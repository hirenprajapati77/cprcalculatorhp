{
  "name": "cpr-calculator-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:clean": "rm -rf .next && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "regression-lock": "tsx scripts/regression_lock.ts",
    "release:check": "tsc --noEmit && npm run lint && npm run regression-lock && npm run test:coverage && npm run security:check && npm run build:clean",
    "test": "npm run test:unit",
    "test:unit": "node --import ./scripts/set-test-env.mjs --import tsx --test --test-force-exit src/tests/unit/**/*.test.ts",
    "test:integration": "node --import ./scripts/set-test-env.mjs --import tsx --test --test-force-exit src/tests/integration/**/*.test.ts",
    "test:e2e": "node --import ./scripts/set-test-env.mjs --import tsx --test --test-concurrency=1 --test-force-exit src/tests/e2e/**/*.test.ts",
    "test:coverage": "c8 node --import ./scripts/set-test-env.mjs --import tsx --test --test-force-exit src/tests/unit/**/*.test.ts && tsx scripts/check-coverage-tiers.ts",
    "test:coverage:core": "c8 --check-coverage --lines 95 --include src/lib/** --include src/services/backtest/** node --import ./scripts/set-test-env.mjs --import tsx --test --test-force-exit src/tests/unit/**/*.test.ts",
    "test:coverage:services": "c8 --check-coverage --lines 85 --include src/services/** --exclude src/services/backtest/** node --import ./scripts/set-test-env.mjs --import tsx --test --test-force-exit src/tests/unit/**/*.test.ts",
    "security:check": "npm audit --audit-level=high",
    "smoke": "tsx scripts/smoke-verify.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.0",
    "bullmq": "^5.78.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "ioredis": "^5.11.1",
    "lightweight-charts": "^5.2.0",
    "lru-cache": "^11.5.1",
    "lucide-react": "^1.17.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.1",
    "yahoo-finance2": "^3.15.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.4",
    "deepmerge-ts": "^8.0.2",
    "fast-uri": "^3.1.7",
    "js-yaml": "^4.3.2",
    "hono": "^4.13.7"
  }
}
