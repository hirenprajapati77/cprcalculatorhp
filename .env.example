# -------------------------------------------------------------
# CPR Platform Environment Variables Template
# -------------------------------------------------------------

# Database
# Production URL (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/cpr_db"

# Redis Configuration (Optional, falls back to memory if empty)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
CACHE_PROVIDER="auto" # 'redis' | 'memory' | 'auto'

# Postgres & Redis Passwords for Docker Compose
POSTGRES_PASSWORD="secure_postgres_password"
REDIS_PASSWORD="secure_redis_password"

# App Configuration
NODE_ENV="development"
APP_BASE_URL="https://your-domain.com"
NEXT_PUBLIC_BASE_URL="https://your-domain.com"
TRUST_PROXY="true"
APP_VERSION="v1.0.0"

# Security & Authentication
# ⚠️ WARNING: If you change CRON_SECRET, you MUST also update the curl commands in the production server's crontab (via `crontab -e`), otherwise background jobs will fail with 401 Unauthorized.
CRON_SECRET="your_secure_cron_secret"
# Required when NODE_ENV=production (server will refuse to start without it)
APP_ACCESS_TOKEN="your_secure_app_access_token"
TOKEN_ENCRYPTION_KEY="your_secure_encryption_key"

# Rate Limiting
RATE_LIMIT_MAX="60"
RATE_LIMIT_WINDOW_MS="60000"

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
TELEGRAM_GROUP_CHAT_ID="your_telegram_group_chat_id"

# Fyers API Configuration
FYERS_APP_ID="your_fyers_app_id"
FYERS_SECRET_ID="your_fyers_secret_id"
FYERS_REDIRECT_URL="https://your-domain.com/api/broker/fyers/callback"
FYERS_AUTH_PROXY_URL="https://your-fyers-proxy.example.workers.dev"
# Optional: Secret for Fyers Auth Proxy if using external Cloudflare worker
PROXY_SHARED_SECRET="your_proxy_secret"

# Market & Backtest Modes
MARKET_DATA_MODE="live"
# CONTINUOUS = exact current production clocks (default — zero drift).
# CLOSING_AUCTION = SEBI CAS clocks for eligible symbols (continuous ends 15:15;
# official close ~15:35). Exchange-live from 2026-08-03 for F&O cash names.
# Flip only after Production Validation (scanner/BTST/STBT/overnight/CPR/journal/Telegram identical under CONTINUOUS).
MARKET_PROFILE="CONTINUOUS"
BACKTEST_EXECUTION_MODE="queue"
# NOTE: this "live" default is correct for the running app, but it also means any
# script that reads HISTORICAL_MODE (e.g. scripts/atr_threshold_audit.ts) inherits
# "live" from your real .env unless it's overridden on the command line, e.g.:
#   HISTORICAL_MODE=mock npx tsx scripts/atr_threshold_audit.ts
# The audit script fails fast now if HISTORICAL_MODE is invalid or mismatched, but
# it can't tell "live" was intentional vs inherited — override it explicitly per run.
HISTORICAL_MODE="live"
# Set to "true" only after a real marketEvent calendar populator job exists and runs
# regularly. While "false", an empty/unpopulated calendar is treated as zero event risk
# instead of forcing every signal to LOW_QUALITY.
EVENT_CALENDAR_ENFORCE_FRESHNESS="false"
EXECUTION_MODE="SHADOW"
BTST_BYPASS_WINDOW="false"

# Volume Price Analysis (confirmation layer — shadow by default)
# Live influence requires AND: VPA_SHADOW_MODE=false AND the specific live flag.
# VPA_SHADOW_MODE=true is a master kill-switch that forces all live paths off.
VPA_ENABLED="true"
VPA_SHADOW_MODE="true"
VPA_LIVE_CONFIDENCE="false"
VPA_LIVE_GATES="false"

# Queues & Scanning
ENABLE_QUEUE="true"
SCAN_QUEUE_THRESHOLD="75"
YAHOO_BATCH_SIZE="10"
YAHOO_MAX_RETRIES="3"
SAVE_IGNORE_SIGNALS="false"
CPR_WEIGHT="35"

# Debug
NEXT_PUBLIC_ENABLE_DEBUG_PANEL="false"
